# .env.local — vedi SPEC_SITO_HOTEL.md Sezione 13

# Sanity
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_PROJECT_ID="9u8ur4ni"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sanity Studio — HTTP Basic Auth in produzione (proxy.ts)
STUDIO_USER=
STUDIO_PASSWORD=

# Booking engine (dual mode — vedi lib/theme.ts)
# NEXT_PUBLIC_BOOKING_ENGINE=teamsystem
# Fase 2: wubook
# WUBOOK_API_URL=
# WUBOOK_PROVIDER_KEY=

# Analytics
# NEXT_PUBLIC_GA_ID=G-...

# Resend — invio email form contatti (app/api/contact/route.ts, lib/resend.ts)
# In sviluppo, senza un dominio verificato: RESEND_MITTENTE deve restare
# onboarding@resend.dev, e Resend consegna SOLO all'indirizzo con cui è
# stato creato l'account — qualunque altro destinatario viene rifiutato.
# Quando un dominio sarà verificato, cambia solo RESEND_MITTENTE, nessuna
# modifica al codice. In questa fase si riusa la stessa API key già
# configurata nel gestionale (backend/.env) — da sostituire con l'account
# aziendale definitivo quando disponibile.
RESEND_API_KEY=
RESEND_MITTENTE=onboarding@resend.dev
CONTACT_EMAIL_TO=info@hoteldelgolfo.com
